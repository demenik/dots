diff --git a/internal/state/mirror.go b/internal/state/mirror.go
new file mode 100644
index 0000000..b8f166b
--- /dev/null
+++ b/internal/state/mirror.go
@@ -0,0 +1,34 @@
+package state
+
+import "path/filepath"
+
+// The two marks a herdr-mirror pane carries locally: the placeholder directory
+// every mirror pane is parked in, and the process each one runs.
+const (
+	mirrorMarkerDir = ".mirror-pane"
+	mirrorCommand   = "herdr-mirror"
+)
+
+// IsMirror reports whether the pane is a herdr-mirror pane: a local window onto
+// a pane on another host. Everything the snapshot says about it locally - the
+// placeholder directory, the herdr-mirror process - describes the mirror rather
+// than what the remote pane is showing, so a title built from it names every
+// mirror pane alike. herdr-mirror keeps such a tab's label in step with the
+// remote itself.
+func (p *PaneState) IsMirror() bool {
+	if p == nil {
+		return false
+	}
+
+	if filepath.Base(filepath.Clean(p.Dir)) == mirrorMarkerDir {
+		return true
+	}
+
+	for _, process := range p.Processes {
+		if process.Name == mirrorCommand {
+			return true
+		}
+	}
+
+	return false
+}
diff --git a/internal/state/mirror_test.go b/internal/state/mirror_test.go
new file mode 100644
index 0000000..aa2be96
--- /dev/null
+++ b/internal/state/mirror_test.go
@@ -0,0 +1,37 @@
+package state
+
+import "testing"
+
+func TestIsMirror(t *testing.T) {
+	cases := []struct {
+		name string
+		pane *PaneState
+		want bool
+	}{
+		{"nil", nil, false},
+		{"empty", &PaneState{}, false},
+		{
+			"placeholder directory",
+			&PaneState{Dir: "/home/dev/.local/state/herdr-mirror/.mirror-pane"},
+			true,
+		},
+		{
+			"herdr-mirror process",
+			&PaneState{Dir: "/home/dev/work", Processes: []Process{{Name: "herdr-mirror"}}},
+			true,
+		},
+		{
+			"plain pane",
+			&PaneState{Dir: "/home/dev/work/dashboard", Processes: []Process{{Name: "nvim"}}},
+			false,
+		},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := tc.pane.IsMirror(); got != tc.want {
+				t.Errorf("IsMirror() = %v, want %v", got, tc.want)
+			}
+		})
+	}
+}
