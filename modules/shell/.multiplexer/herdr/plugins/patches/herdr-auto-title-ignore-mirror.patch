+func TestAMirrorPaneIsLeftForHerdrMirror(t *testing.T) {
+	// Every herdr-mirror pane sits in the same placeholder directory and runs
+	// the same process, so a title built from that names them all alike.
+	// herdr-mirror keeps their labels in step with the remote itself.
+	cfg := testConfig()
+	cfg.IgnoreMirror = true
+	h := startConfigured(t, herdrtest.New(
+		[]herdr.TabInfo{{TabID: "wE:t1", Label: "1"}},
+		[]herdr.PaneInfo{{
+			PaneID: "wE:p1", TabID: "wE:t1", Focused: true,
+			CWD: "/Users/dev/.local/state/herdr-mirror/.mirror-pane",
+		}},
+	), cfg)
+	h.awaitPolls(5)
+
+	if renames := h.client.Renames(); len(renames) != 0 {
+		t.Errorf("issued %v, want no rename of a mirror tab", renames)
+	}
+}
+
+func TestAMirrorPaneIsNamedWhenIgnoreMirrorIsOff(t *testing.T) {
+	// The guard is the only thing holding the rename back: with it off the
+	// same pane is named from its placeholder directory like any other.
+	cfg := testConfig()
+	cfg.IgnoreMirror = false
+	h := startConfigured(t, herdrtest.New(
+		[]herdr.TabInfo{{TabID: "wE:t1", Label: "1"}},
+		[]herdr.PaneInfo{{
+			PaneID: "wE:p1", TabID: "wE:t1", Focused: true,
+			CWD: "/Users/dev/.local/state/herdr-mirror/.mirror-pane",
+		}},
+	), cfg)
+
+	if got := h.awaitRenames(1)[0].Label; got != ".mirror-pane" {
+		t.Errorf("rename = %q, want .mirror-pane", got)
+	}
+}
