+keeper.combines = function(main_nr, lang)
+  local combine = (OtterConfig.buffers.combine_injections or {})[keeper.rafts[main_nr].main_lang]
+  return combine == true or (type(combine) == "table" and vim.tbl_contains(combine, lang))
+end
+
+keeper.otter_key = function(main_nr, lang, n)
+  if keeper.combines(main_nr, lang) then
+    return lang
+  end
+  return lang .. "#" .. n
+end
+
+keeper.chunk_groups = function(main_nr, lang, chunks)
+  if keeper.combines(main_nr, lang) then
+    return { chunks }
+  end
+  local groups, index = {}, {}
+  for _, chunk in ipairs(chunks) do
+    local id = chunk.group or chunk
+    if index[id] == nil then
+      table.insert(groups, {})
+      index[id] = #groups
+    end
+    table.insert(groups[index[id]], chunk)
+  end
+  return groups
+end
+
+---@param position table? 0-based (row, col), defaults to the cursor
+keeper.get_otter_nr = function(main_nr, lang, position)
+  local raft = keeper.rafts[main_nr]
+  if keeper.combines(main_nr, lang) then
+    return raft.buffers[lang]
+  end
+  if position == nil then
+    local cursor = api.nvim_win_get_cursor(0)
+    position = { cursor[1] - 1, cursor[2] }
+  end
+  for n, group in ipairs(keeper.chunk_groups(main_nr, lang, raft.code_chunks[lang] or {})) do
+    for _, chunk in ipairs(group) do
+      if pos_le(chunk.range.from, position) and pos_le(position, chunk.range.to) then
+        return raft.buffers[keeper.otter_key(main_nr, lang, n)]
+      end
+    end
+  end
+  return nil
+end
+
+keeper.add_otter = function(main_nr, lang, key, lines)
+  local raft = keeper.rafts[main_nr]
+  local n = key:match("#(%d+)$")
+  local extension = (n and "." .. n or "") .. "." .. OtterConfig.extensions[lang]
+  local otter_path = fn.path_to_otterpath(api.nvim_buf_get_name(main_nr), extension)
+  local otter_uri = "file://" .. otter_path
+  local otter_nr = vim.uri_to_bufnr(otter_uri)
+  api.nvim_buf_set_name(otter_nr, otter_path)
+  api.nvim_set_option_value("swapfile", false, { buf = otter_nr })
+  raft.buffers[key] = otter_nr
+  raft.paths[key] = otter_path
+  raft.otter_nr_to_lang[otter_nr] = lang
+  api.nvim_buf_set_lines(otter_nr, 0, -1, false, lines)
+
+  local cleanup = function(ev)
+    if api.nvim_buf_is_loaded(otter_nr) then
+      api.nvim_buf_delete(otter_nr, { force = true })
+      vim.fn.delete(otter_path)
+    end
+  end
+  api.nvim_create_autocmd({ "BufDelete", "BufWipeout" }, {
+    buffer = main_nr,
+    group = api.nvim_create_augroup("OtterAutocloseOnMainDelete" .. otter_nr, {}),
+    callback = cleanup,
+  })
+  -- ExitPre, not QuitPre: the main buffer may still be loaded in another window
+  api.nvim_create_autocmd({ "ExitPre" }, {
+    pattern = "*",
+    group = api.nvim_create_augroup("OtterAutocloseOnQuit" .. otter_nr, {}),
+    callback = cleanup,
+  })
+
+  if OtterConfig.buffers.write_to_disk then
+    api.nvim_create_autocmd("BufWritePost", {
+      buffer = main_nr,
+      group = api.nvim_create_augroup("OtterAutowrite" .. otter_nr, {}),
+      callback = function(_)
+        if api.nvim_buf_is_loaded(otter_nr) then
+          keeper.sync_raft(main_nr)
