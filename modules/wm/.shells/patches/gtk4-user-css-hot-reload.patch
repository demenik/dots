+
+      css_dir = g_build_filename (g_get_user_config_dir (), "gtk-4.0", NULL);
+      css_dir_file = g_file_new_for_path (css_dir);
+      css_monitor = g_file_monitor_directory (css_dir_file, G_FILE_MONITOR_NONE, NULL, NULL);
+      if (css_monitor)
+        g_signal_connect (css_monitor, "changed",
+                          G_CALLBACK (user_css_dir_changed), css_provider);
+
+      g_object_unref (css_dir_file);
